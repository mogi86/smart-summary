{
  "name": "@smart-summary/app",
  "private": true,
  "type": "module",
  "scripts": {
    "cli": "tsx --env-file-if-exists=../.env src/presentation/cli/main.ts",
    "db:init": "tsx --env-file-if-exists=../.env src/infrastructure/dynamodb/createLocalTable.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch --env-file-if-exists=../.env src/presentation/http/localServer.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1146.0",
    "@aws-sdk/client-lambda": "^3.1146.0",
    "@aws-sdk/client-ssm": "^3.1146.0",
    "@aws-sdk/lib-dynamodb": "^3.1146.0",
    "@google/genai": "^2.27.0",
    "@hono/node-server": "^2.1.3",
    "@langfuse/otel": "^5.11.1",
    "@langfuse/tracing": "^5.11.1",
    "@opentelemetry/sdk-node": "^0.222.0",
    "hono": "^4.13.12",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
